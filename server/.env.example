# ---------------------------------------------------------------------------
# Server environment. Copy to .env and fill in. Never commit the real .env.
# ---------------------------------------------------------------------------

# development | production
NODE_ENV=development
PORT=4000

# Where the React app runs. Comma-separate several origins if needed.
FRONTEND_URL=http://localhost:5173

# Staff authentication
STAFF_USERNAME=staff
# Generate with: npm run hash -- "your-password"
# Leave empty to use the demo password "coffee123" (development only).
STAFF_PASSWORD_HASH=
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=8h

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# Leave REDIS_URL empty to use the local JSON file driver (server/data/db.json).
# Set it to a persistent Redis to satisfy the deployment requirement:
#   Upstash:      rediss://default:PASSWORD@your-endpoint.upstash.io:6379
#   Render KV:    rediss://red-xxxx:PASSWORD@oregon-keyvalue.render.com:6379
#   Local Docker: redis://localhost:6379
REDIS_URL=

# Force a driver regardless of REDIS_URL: redis | file
# STORE_DRIVER=file
